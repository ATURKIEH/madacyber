{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowWriteResultsToBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::subdomain-enum-results-aref-4821/*"
    },
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::subdomain-enum-results-aref-4821"
    }
  ]
}
